{
  "name": "thinkglaos-organizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-build.mjs",
    "check": "tsc --noEmit && tsx --test tests/*.test.ts",
    "prepare:data": "tsx scripts/prepare-data.ts",
    "refresh:catalog": "node scripts/catalog-youtube.mjs && node scripts/prepare-quotes.mjs",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
