{
  "manifest_version": 3,
  "name": "Thinkglaos · Mezclador de música",
  "version": "2.1.0",
  "description": "Mezcla estable para YouTube Music y Spotify web, conservando el silencio de cada escena al pausar los contadores.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spotigetta.github.io/Thinkglaos_app/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "js": ["bridge.js"]
    }
  ]
}
